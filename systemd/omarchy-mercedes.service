[Unit]
Description=omarchy-mercedes connector (experimental, read-only)
Documentation=https://github.com/hendkai/omarchy-mercedes
# Never let the daemon spin on crashes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-mercedes daemon --region eu
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077
# User units cannot set SupplementaryGroups. Filesystem namespace sandboxing
# depends on unprivileged user namespaces, often disabled by host policy.
# Do not claim ProtectSystem/PrivateTmp isolation without testing that host.

[Install]
WantedBy=default.target
